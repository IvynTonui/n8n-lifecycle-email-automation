{
  "name": "[SEGMENT] Country-Based — Segmentation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "15 1 * * *"
            }
          ]
        }
      },
      "id": "df7d72cc-b048-4627-8bf4-f67704e747b8",
      "name": "Daily 01:15 UTC (04:15 EAT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Country-based segmentation\n-- Generates one segment per whitelisted country\n-- Whitelist driven by user count threshold (10+) — see D4 in pending decisions\n-- Update the IN list when adding/removing countries\nSELECT\n    au.id AS user_id,\n    au.email,\n    'country_' || LOWER(au.country) AS segment_name\nFROM auth_user au\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true\n  AND au.country IN ('GH', 'ZA', 'KE', 'ZM', 'CN', 'NG');",
        "options": {}
      },
      "id": "289a6022-718c-4d45-847d-1e800b565758",
      "name": "Fetch country members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.user_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f421d678-0d56-402e-b2e0-2aa3588474d6",
      "name": "Any members?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\n-- Each item carries its own segment_name (country_gh, country_za, etc.)\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
      },
      "id": "40492162-d625-45f1-9f5e-e4fd943cf684",
      "name": "Upsert into user_segments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove stale members from country segments\n-- Catches: user moved country, country dropped from whitelist, account disabled, etc.\n-- The LIKE 'country_%' pattern targets only country segments\nDELETE FROM user_segments\nWHERE segment_name LIKE 'country_%'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND au.country IN ('GH', 'ZA', 'KE', 'ZM', 'CN', 'NG')\n  );\n\n-- Also remove rows where the user moved countries\n-- (e.g., was in country_ke, now in country_gh — old country_ke row needs removal)\nDELETE FROM user_segments us\nUSING auth_user au\nWHERE us.user_id = au.id\n  AND us.segment_name LIKE 'country_%'\n  AND us.segment_name != 'country_' || LOWER(au.country);",
        "options": {}
      },
      "id": "ad9c1d38-caea-4e9c-8574-3cb25f4486a8",
      "name": "Remove stale members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {},
      "id": "294624e6-c17b-429c-9752-eaf75db065c9",
      "name": "No members — clean exit",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
