{
  "name": "[SEGMENT] Inactive Users — Segmentation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "5e34c127-040e-4f46-8775-191686848346",
      "name": "Daily 00:00 UTC (03:00 EAT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Inactive users: last order 30+ days ago, OR never ordered\n-- Threshold set at 30 days based on reorder-gap analysis of order history\nSELECT\n    au.id AS user_id,\n    au.email,\n    'inactive_users' AS segment_name\nFROM auth_user au\nLEFT JOIN (\n    SELECT user_id, MAX(created_on) AS last_order_date\n    FROM orders\n    WHERE deleted = false\n    GROUP BY user_id\n) o ON au.id = o.user_id\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true\n  AND (\n      o.last_order_date IS NULL                          -- never ordered\n      OR o.last_order_date < NOW() - INTERVAL '30 days'  -- last order 30+ days ago\n  );",
        "options": {}
      },
      "id": "79a56840-7213-489a-b181-546308187649",
      "name": "Fetch segment members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.user_id }}",
              "rightValue": "",
