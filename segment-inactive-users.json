              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2ea938c2-c770-4e55-a420-608be3b9e184",
      "name": "Any members?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\n-- IMPORTANT: do NOT touch campaign_last_sent_at — preserves cooldown timestamps\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
      },
      "id": "d428ec1c-db37-4fd0-95d4-c3f092d52c39",
      "name": "Upsert into user_segments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove users no longer in the segment\n-- (e.g., they placed an order in the last 30 days, account disabled, etc.)\nDELETE FROM user_segments\nWHERE segment_name = 'inactive_users'\n  AND user_id NOT IN (\n      SELECT au.id\n      FROM auth_user au\n      LEFT JOIN (\n          SELECT user_id, MAX(created_on) AS last_order_date\n          FROM orders\n          WHERE deleted = false\n          GROUP BY user_id\n      ) o ON au.id = o.user_id\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND (\n            o.last_order_date IS NULL\n            OR o.last_order_date < NOW() - INTERVAL '30 days'\n        )\n  );",
        "options": {}
      },
      "id": "8f10d285-7ee5-4350-b4b4-ad577c34bdef",
      "name": "Remove stale members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        224,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
