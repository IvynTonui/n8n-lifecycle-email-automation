      "id": "ef01cc5c-eed3-415e-a5b2-ff1c674fea5a",
      "name": "Any members?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\n-- IMPORTANT: do NOT touch campaign_last_sent_at — preserves cooldown timestamps\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
      },
      "id": "2dca6084-c239-4d73-9c67-444a92b34c1e",
      "name": "Upsert into user_segments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove users no longer in the segment\n-- (e.g., their delivered order was refunded/deleted, account disabled, etc.)\nDELETE FROM user_segments\nWHERE segment_name = 'delivered_orders'\n  AND user_id NOT IN (\n      SELECT DISTINCT au.id\n      FROM auth_user au\n      INNER JOIN orders o ON au.id = o.user_id\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND o.deleted = false\n        AND o.status = 'DELIVERED'\n  );",
        "options": {}
      },
      "id": "e0963a27-0a3b-4f02-94f9-296347f1d9d9",
      "name": "Remove stale members",
      "type": "n8n-nodes-base.postgres",
