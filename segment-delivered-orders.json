    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Find all customers with at least one delivered order\nSELECT DISTINCT\n    au.id AS user_id,\n    au.email,\n    'delivered_orders' AS segment_name\nFROM auth_user au\nINNER JOIN orders o ON au.id = o.user_id\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true\n  AND o.deleted = false\n  AND o.status = 'DELIVERED';",
        "options": {}
      },
      "id": "06a26d67-d496-4938-8bf9-8be6724f1d6a",
      "name": "Fetch segment members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.user_id }}",
              "rightValue": "",
              "operator": {
