      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Repeat customers: 2+ real orders (excluding DRAFT and CANCELED)\n-- COALESCE handles NULL order_state values (most non-DRAFT orders have NULL here)\nSELECT\n    au.id AS user_id,\n    au.email,\n    'repeat_customers' AS segment_name\nFROM auth_user au\nINNER JOIN (\n    SELECT user_id, COUNT(*) AS order_count\n    FROM orders\n    WHERE deleted = false\n      AND COALESCE(order_state, '') != 'DRAFT'\n      AND status != 'CANCELED'\n    GROUP BY user_id\n    HAVING COUNT(*) >= 2\n) o ON au.id = o.user_id\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true;",
        "options": {}
      },
      "id": "233cdbc1-9b63-4942-8d6c-54204fa2c06b",
      "name": "Fetch segment members",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -448,
        112
      ],
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
