              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9530d87e-86d6-4659-ac3f-2ba96b832fa1",
      "name": "Any members?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\n-- IMPORTANT: do NOT touch campaign_last_sent_at — preserves cooldown timestamps\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
      },
      "id": "ba582eeb-3a37-493c-ab44-40666110a350",
      "name": "Upsert into user_segments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove users no longer in the segment\n-- (e.g., orders deleted, account disabled, drops below 2 orders, etc.)\nDELETE FROM user_segments\nWHERE segment_name = 'repeat_customers'\n  AND user_id NOT IN (\n      SELECT au.id\n      FROM auth_user au\n      INNER JOIN (\n          SELECT user_id, COUNT(*) AS order_count\n          FROM orders\n          WHERE deleted = false\n            AND COALESCE(order_state, '') != 'DRAFT'\n            AND status != 'CANCELED'\n          GROUP BY user_id\n          HAVING COUNT(*) >= 2\n      ) o ON au.id = o.user_id\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n  );",
        "options": {}
      },
      "id": "13a4fa53-11b5-417f-948f-d503a1c1c985",
      "name": "Remove stale members",
      "type": "n8n-nodes-base.postgres",
