    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Direct customers: no referring agent\nSELECT\n    au.id AS user_id,\n    au.email,\n    'direct_customers' AS segment_name\nFROM auth_user au\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true\n  AND au.referring_agent_id IS NULL;",
        "options": {}
