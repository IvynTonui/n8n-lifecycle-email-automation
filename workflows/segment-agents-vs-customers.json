    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Agents themselves (for agent-specific campaigns)\n-- Note: agent filter doesn't include email_verified — check with team if needed\nSELECT\n    au.id AS user_id,\n    au.email,\n    'agents' AS segment_name\nFROM auth_user au\nWHERE au.role = 'AGENT'\n  AND au.deleted = false\n  AND au.enable = true;",
        "options": {}
      },
      "id": "09990eb8-ecaa-463a-b913-e68ed1f902f5",
