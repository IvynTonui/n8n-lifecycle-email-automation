      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\n-- Each item has its own segment_name, so this routes correctly\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
      },
      "id": "37d42a1d-18d8-461f-aafb-46f2664cf6d9",
      "name": "Upsert into user_segments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        672,
        112
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "FAKE_POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove stale members across all 3 segments\nDELETE FROM user_segments\nWHERE segment_name = 'direct_customers'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND au.referring_agent_id IS NULL\n  );\n\nDELETE FROM user_segments\nWHERE segment_name = 'agent_referred_customers'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND au.referring_agent_id IS NOT NULL\n  );\n\nDELETE FROM user_segments\nWHERE segment_name = 'agents'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'AGENT'\n        AND au.deleted = false\n        AND au.enable = true\n  );",
        "options": {}
      },
      "id": "dcc341c0-d89d-4fbd-a5c2-2a9edb66748e",
      "name": "Remove stale members",
      "type": "n8n-nodes-base.postgres",
