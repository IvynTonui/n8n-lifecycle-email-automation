    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Agent-referred customers: has a referring agent\nSELECT\n    au.id AS user_id,\n    au.email,\n    'agent_referred_customers' AS segment_name\nFROM auth_user au\nWHERE au.role = 'CUSTOMER'\n  AND au.deleted = false\n  AND au.enable = true\n  AND au.email_verified = true\n  AND au.referring_agent_id IS NOT NULL;",
        "options": {}
      },
      "id": "f43b292e-889c-44de-ab0d-4dd71a55d374",
      "name": "Fetch agent-referred customers",
