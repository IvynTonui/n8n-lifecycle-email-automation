    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Upsert: insert new members, refresh segmented_at for existing ones\nINSERT INTO user_segments (user_id, email, segment_name, segmented_at)\nVALUES ($1, $2, $3, NOW())\nON CONFLICT (user_id, segment_name)\nDO UPDATE SET\n    segmented_at = NOW(),\n    email = EXCLUDED.email;",
        "options": {
          "queryReplacement": "={{ $json.user_id }},={{ $json.email }},={{ $json.segment_name }}"
        }
