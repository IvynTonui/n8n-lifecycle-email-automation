    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Remove stale members across both segments\nDELETE FROM user_segments\nWHERE segment_name = 'company_users'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND au.user_type = 'COMPANY'\n  );\n\nDELETE FROM user_segments\nWHERE segment_name = 'individual_users'\n  AND user_id NOT IN (\n      SELECT au.id FROM auth_user au\n      WHERE au.role = 'CUSTOMER'\n        AND au.deleted = false\n        AND au.enable = true\n        AND au.email_verified = true\n        AND au.user_type = 'INDIVIDUAL'\n  );",
        "options": {}
